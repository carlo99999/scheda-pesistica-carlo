{
    "program_name": "Hypertrophy Upper + Lower Minimal (post-BJJ)",
    "version": "1.0",
    "goal": {
      "primary": ["ipertrofia_schiena", "ipertrofia_braccia", "ipertrofia_spalle", "ipertrofia_petto"],
      "secondary": ["mantenimento_forza_gambe", "base_forza_generale"]
    },
    "context": {
      "bjj_before_weights": true,
      "bjj_frequency": "daily",
      "session_duration_minutes": { "min": 35, "max": 55 },
      "intensity_policy": {
        "default_RIR_range": [1, 2],
        "no_failure_on": ["pull_up", "dip", "squat", "deadlift_variants"],
        "if_bjj_was_hard": "taglia 1 esercizio oppure 1-2 serie totali, mantieni RIR >= 2"
      }
    },
    "weekly_template": [
      { "day": "Mon", "workout_id": "D1_PULL_HEAVY" },
      { "day": "Tue", "workout_id": "D2_LOWER_MIN" },
      { "day": "Thu", "workout_id": "D3_PUSH" },
      { "day": "Sat", "workout_id": "D4_SHOULDERS_PULL_VOLUME_ARMS" }
    ],
    "progression_rules": [
      {
        "rule": "double_progression",
        "description": "Se completi tutte le serie al top del range con RIR target, aumenta il carico del minimo step e riparti dal basso del range."
      },
      {
        "rule": "deload",
        "frequency_weeks": { "min": 6, "max": 8 },
        "description": "Per 1 settimana: dimezza le serie (o mantieni le serie e alza RIR a 3-4)."
      }
    ],
    "workouts": [
      {
        "workout_id": "D1_PULL_HEAVY",
        "title": "Pull pesante (schiena + bicipiti)",
        "exercises": [
          {
            "name": "Pull-up zavorrati",
            "sets": 6,
            "reps_range": [4, 6],
            "target_RIR": [1, 2],
            "rest_seconds": [120, 180],
            "notes": ["tecnica pulita, nessun grinding", "progressione: quando fai 6x6 con +10kg, aumenta zavorra al minimo step disponibile"]
          },
          {
            "name": "Rematore manubrio (1 braccio)",
            "sets": 4,
            "reps_range": [8, 12],
            "target_RIR": [1, 2],
            "rest_seconds": [90, 150],
            "notes": ["controllo scapole, tronco stabile"]
          },
          {
            "name": "Inverted row (anelli o sbarra bassa)",
            "sets": 3,
            "reps_range": [10, 15],
            "target_RIR": [1, 2],
            "rest_seconds": [60, 120],
            "notes": ["se troppo facile: piedi rialzati o zavorra leggera"]
          },
          {
            "name": "Curl manubri",
            "sets": 3,
            "reps_range": [8, 12],
            "target_RIR": [1, 2],
            "rest_seconds": [60, 90],
            "notes": ["gomiti fermi, ROM completo"]
          },
          {
            "name": "Hammer curl",
            "sets": 2,
            "reps_range": [10, 15],
            "target_RIR": [1, 2],
            "rest_seconds": [60, 90],
            "notes": ["focus avambraccio e brachiale"]
          }
        ]
      },
      {
        "workout_id": "D2_LOWER_MIN",
        "title": "Lower minimo efficace (squat + stacco)",
        "exercises": [
          {
            "name": "Squat (back o front)",
            "sets": 4,
            "reps_range": [3, 6],
            "target_RIR": [2, 2],
            "rest_seconds": [120, 180],
            "notes": ["se BJJ pesante: resta su 4x3-4 a RIR 2-3"]
          },
          {
            "name": "Deadlift (scegli 1 variante)",
            "choose_one": true,
            "options": [
              {
                "variant": "Stacco rumeno (RDL)",
                "sets": 3,
                "reps_range": [6, 10],
                "target_RIR": [2, 2],
                "rest_seconds": [120, 180],
                "notes": ["più sostenibile post-BJJ", "hinge controllato, no rimbalzo"]
              },
              {
                "variant": "Stacco classico",
                "sets": 5,
                "reps_range": [2, 4],
                "target_RIR": [2, 2],
                "rest_seconds": [150, 210],
                "notes": ["solo se lombari freschi", "tecnica perfetta, no grinder"]
              }
            ]
          },
          {
            "name": "Affondi (camminati o bulgari)",
            "sets": 2,
            "reps_range": [8, 12],
            "target_RIR": [2, 2],
            "rest_seconds": [60, 120],
            "notes": ["per lato", "volume minimo"]
          },
          {
            "name": "Core (scegli 1)",
            "choose_one": true,
            "options": [
              {
                "variant": "Plank RKC",
                "sets": 3,
                "duration_seconds_range": [20, 30],
                "rest_seconds": [45, 75],
                "notes": ["tensione alta, respirazione controllata"]
              },
              {
                "variant": "Ab wheel",
                "sets": 3,
                "reps_range": [6, 10],
                "target_RIR": [2, 2],
                "rest_seconds": [60, 120],
                "notes": ["anti-estensione, bacino in retroversione"]
              }
            ]
          }
        ],
        "conditional_note": "Se schiena 'carica' dal grappling: fai squat + RDL e stop."
      },
      {
        "workout_id": "D3_PUSH",
        "title": "Push (petto + tricipiti)",
        "exercises": [
          {
            "name": "Panca (bilanciere o manubri)",
            "sets": 4,
            "reps_range": [6, 10],
            "target_RIR": [1, 2],
            "rest_seconds": [120, 180],
            "notes": ["se energia bassa: usa manubri e tieni RIR 2"]
          },
          {
            "name": "Incline manubri O push-up zavorrati",
            "sets": 3,
            "reps_range": [8, 12],
            "target_RIR": [1, 2],
            "rest_seconds": [90, 150],
            "notes": ["scegli la variante più stabile post-BJJ"]
          },
          {
            "name": "Croci manubri (panca o pavimento)",
            "sets": 3,
            "reps_range": [10, 15],
            "target_RIR": [1, 2],
            "rest_seconds": [60, 120],
            "notes": ["stretch controllato, niente rimbalzo"]
          },
          {
            "name": "Dips O close-grip push-up zavorrati",
            "sets": 3,
            "reps_range": [6, 12],
            "target_RIR": [1, 2],
            "rest_seconds": [90, 150],
            "notes": ["se spalle/gomiti sensibili: usa close-grip push-up"]
          },
          {
            "name": "Skull crusher / French press",
            "sets": 2,
            "reps_range": [8, 12],
            "target_RIR": [1, 2],
            "rest_seconds": [60, 120],
            "notes": ["controllo, gomiti stabili"]
          }
        ]
      },
      {
        "workout_id": "D4_SHOULDERS_PULL_VOLUME_ARMS",
        "title": "Spalle + Pull volume + braccia",
        "exercises": [
          {
            "name": "Pull-up volume (BW o leggera zavorra)",
            "sets": 4,
            "reps_range": [8, 12],
            "target_RIR": [1, 2],
            "rest_seconds": [90, 150],
            "notes": ["se scegli zavorra: usa +0/+5kg e resta nel range 6-10 con 5 serie"]
          },
          {
            "name": "Military press (bilanciere o manubri)",
            "sets": 4,
            "reps_range": [6, 10],
            "target_RIR": [1, 2],
            "rest_seconds": [120, 180],
            "notes": ["no cedimento, traiettoria stabile"]
          },
          {
            "name": "Alzate laterali",
            "sets": 4,
            "reps_range": [12, 20],
            "target_RIR": [1, 2],
            "rest_seconds": [45, 75],
            "notes": ["volume chiave per spalle grosse"]
          },
          {
            "name": "Rear delt raise (busto flesso o panca inclinata)",
            "sets": 4,
            "reps_range": [15, 25],
            "target_RIR": [1, 2],
            "rest_seconds": [45, 75],
            "notes": ["priorità deltoidi posteriori per spalle complete"]
          },
          {
            "name": "Superset braccia",
            "superset": true,
            "pair": [
              {
                "name": "Curl inclinato",
                "sets": 2,
                "reps_range": [10, 15],
                "target_RIR": [1, 2],
                "rest_seconds": [0, 0],
                "notes": ["passa subito al tricipite"]
              },
              {
                "name": "Estensioni tricipiti sopra testa (manubrio)",
                "sets": 2,
                "reps_range": [10, 15],
                "target_RIR": [1, 2],
                "rest_seconds": [60, 90],
                "notes": ["rest dopo la coppia"]
              }
            ]
          }
        ]
      }
    ],
    "optional_micro_sessions": [
      {
        "title": "Micro-pump braccia (15-20 min)",
        "frequency_per_week": { "min": 0, "max": 2 },
        "exercises": [
          { "name": "Superset: curl manubri + close-grip push-up", "sets": 3, "reps_range": [12, 20], "rest_seconds": [60, 90] },
          { "name": "Superset: hammer curl + estensioni sopra testa", "sets": 2, "reps_range": [12, 20], "rest_seconds": [60, 90] }
        ],
        "condition": "solo se recupero buono e nessun dolore tendineo"
      },
      {
        "title": "Micro-pump spalle (15-20 min)",
        "frequency_per_week": { "min": 0, "max": 2 },
        "exercises": [
          { "name": "Alzate laterali", "sets": 5, "reps_range": [15, 25], "rest_seconds": [45, 60] },
          { "name": "Rear delt raise", "sets": 5, "reps_range": [15, 25], "rest_seconds": [45, 60] },
          { "name": "Y-raise (leggero)", "sets": 2, "reps_range": [12, 20], "rest_seconds": [45, 60] }
        ],
        "condition": "solo se spalle/gomiti stanno bene"
      }
    ]
  }